+ */
+-->
+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+    <!-- Headline / Body font Lato overlay -->
+    <string name="font_ios_overlay" translatable="false">iOS</string>
+</resources>
diff --git a/prebuilt/product/etc/fonts_customization.xml b/prebuilt/product/etc/fonts_customization.xml
index a2f6359..bf3d9a0 100644
--- a/prebuilt/product/etc/fonts_customization.xml
+++ b/prebuilt/product/etc/fonts_customization.xml
@@ -620,6 +620,8 @@
     <family customizationType="new-named-family" name="ios">
         <font weight="300" style="normal">ios.ttf</font>
     </family>
+    <!-- SFPro-SemiboldStencil clock font: same SF Pro Stencil face -->
+    <alias name="sanfrancisco-sb-stencil-clock" to="ios" />
     
     <!-- Hercules -->
     <family customizationType="new-named-family" name="hercules">
diff --git a/themes.mk b/themes.mk
index bef934f..5a089d1 100644
--- a/themes.mk
+++ b/themes.mk
@@ -129,6 +129,7 @@ PRODUCT_PACKAGES += \
     ClockFontKaramuruhOverlay \
     ClockFontKingthingsOverlay \
     ClockFontLMSCliffordOverlay \
+    ClockFontIosOverlay \
     ClockFontLatoOverlay \
     ClockFontLinotteOverlay \
     ClockFontLittleBunnyOverlay \
