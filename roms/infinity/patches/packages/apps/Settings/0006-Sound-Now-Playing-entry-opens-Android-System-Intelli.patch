 res/xml/sound_settings.xml                    |  9 ++
 .../sound/NowPlayingPreferenceController.java | 85 +++++++++++++++++++
 3 files changed, 100 insertions(+)
 create mode 100644 res/values/now_playing_strings.xml
 create mode 100644 src/com/android/settings/sound/NowPlayingPreferenceController.java

diff --git a/res/values/now_playing_strings.xml b/res/values/now_playing_strings.xml
new file mode 100644
index 0000000..264367b
--- /dev/null
+++ b/res/values/now_playing_strings.xml
@@ -0,0 +1,6 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- Now Playing entry in Sound settings -->
+    <string name="now_playing_settings_title">Now Playing</string>
+    <string name="now_playing_settings_summary">Identify songs playing nearby</string>
+</resources>
diff --git a/res/xml/sound_settings.xml b/res/xml/sound_settings.xml
index 5e95002..b84089c 100644
--- a/res/xml/sound_settings.xml
+++ b/res/xml/sound_settings.xml
@@ -222,6 +222,15 @@
             settings:controller="com.android.settings.sound.MediaControlsParentPreferenceController"
             settings:keywords="@string/keywords_media_controls"/>
 
+        <!-- Now Playing: Android System Intelligence disables its own settings tile after a Play
+             update, so link straight to an activity that stays enabled. -->
+        <Preference
+            android:key="now_playing_settings"
+            android:title="@string/now_playing_settings_title"
+            android:summary="@string/now_playing_settings_summary"
+            android:order="-99"
+            settings:controller="com.android.settings.sound.NowPlayingPreferenceController"/>
+
         <com.android.settingslib.PrimarySwitchPreference
             android:key="gesture_prevent_ringing_sound"
             android:title="@string/gesture_prevent_ringing_sound_title"
diff --git a/src/com/android/settings/sound/NowPlayingPreferenceController.java b/src/com/android/settings/sound/NowPlayingPreferenceController.java
new file mode 100644
