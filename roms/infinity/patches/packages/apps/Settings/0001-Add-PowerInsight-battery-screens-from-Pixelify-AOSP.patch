+
+        item(key = "danger") {
+            SettingsGroup {
+                action(
+                    title = stringResource(R.string.power_insight_manual_reset),
+                    summary = stringResource(R.string.power_insight_manual_reset_summary),
+                    titleColor = MaterialTheme.colorScheme.error,
+                    onClick = { showResetConfirmDialog = true },
