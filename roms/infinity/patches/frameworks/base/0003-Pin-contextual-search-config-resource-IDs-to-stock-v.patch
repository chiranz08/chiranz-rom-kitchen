From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chiranz <chiranz08@users.noreply.github.com>
Date: Sun, 4 Oct 2026 09:31:12 +0000
Subject: [PATCH 03/14] Pin contextual search config resource IDs to stock
 values

Prebuilt Pixel Launcher reads config_defaultContextualSearchPackageName by its
numeric ID (0x01040276). Infinity's extra framework strings shifted the four
contextual search configs by one, so the launcher read "omni.enable_vis" as the
package and Circle to Search reported unavailable. Pin the IDs (as Evolution X
does) and teach aapt2 to honour <java-symbol id=...> for private resources.
---
 core/res/res/values/symbols.xml  |  8 ++++----
 tools/aapt2/ResourceParser.cpp   | 11 +++++++++++
 tools/aapt2/link/TableMerger.cpp |  7 +++----
 3 files changed, 18 insertions(+), 8 deletions(-)

diff --git a/core/res/res/values/symbols.xml b/core/res/res/values/symbols.xml
index b4ea38468..427a66c38 100644
--- a/core/res/res/values/symbols.xml
+++ b/core/res/res/values/symbols.xml
@@ -6263,10 +6263,10 @@
   <java-symbol type="bool" name="config_displayBrightnessAsyncSensorReadingEnabled" />
 
   <java-symbol type="bool" name="config_watchlistUseFileHashesCache" />
-  <java-symbol type="string" name="config_defaultContextualSearchPackageName" />
-  <java-symbol type="string" name="config_defaultContextualSearchKey" />
-  <java-symbol type="string" name="config_defaultContextualSearchEnabled" />
-  <java-symbol type="string" name="config_defaultContextualSearchLegacyEnabled" />
+  <java-symbol type="string" name="config_defaultContextualSearchPackageName" id="0x01040276" />
+  <java-symbol type="string" name="config_defaultContextualSearchKey" id="0x01040274" />
+  <java-symbol type="string" name="config_defaultContextualSearchEnabled" id="0x01040273" />
+  <java-symbol type="string" name="config_defaultContextualSearchLegacyEnabled" id="0x01040275" />
 
   <java-symbol type="string" name="unarchival_session_app_label" />
 
diff --git a/tools/aapt2/ResourceParser.cpp b/tools/aapt2/ResourceParser.cpp
index ee8ccaa28..c7284a1b6 100644
--- a/tools/aapt2/ResourceParser.cpp
+++ b/tools/aapt2/ResourceParser.cpp
@@ -1135,6 +1135,17 @@ bool ResourceParser::ParseSymbolImpl(xml::XmlPullParser* parser,
     return false;
   }
 
+  if (std::optional<StringPiece> maybe_id_str = xml::FindNonEmptyAttribute(parser, "id")) {
+    std::optional<ResourceId> maybe_id = ResourceUtils::ParseResourceId(maybe_id_str.value());
+    if (!maybe_id) {
+      diag_->Error(android::DiagMessage(out_resource->source)
+                   << "invalid resource ID '" << maybe_id_str.value() << "' in <"
+                   << parser->element_name() << "> tag");
+      return false;
+    }
+    out_resource->id = maybe_id.value();
+  }
+
   out_resource->name.type = parsed_type->ToResourceNamedType();
   return true;
 }
diff --git a/tools/aapt2/link/TableMerger.cpp b/tools/aapt2/link/TableMerger.cpp
index d43fc052c..81ebb3653 100644
--- a/tools/aapt2/link/TableMerger.cpp
+++ b/tools/aapt2/link/TableMerger.cpp
@@ -107,10 +107,9 @@ static bool MergeEntry(IAaptContext* context, const android::Source& src, Resour
 
   // Copy over the strongest visibility.
   if (src_entry->visibility.level > dst_entry->visibility.level) {
-    // Only copy the ID if the source is public, or else the ID is meaningless.
-    if (src_entry->visibility.level == Visibility::Level::kPublic) {
-      dst_entry->id = src_entry->id;
-    }
+    // Copy the ID even for non-public entries: <java-symbol id=".."> pins private framework
+    // resource IDs that prebuilt Google apps reference by number.
+    dst_entry->id = src_entry->id;
     dst_entry->visibility = std::move(src_entry->visibility);
   } else if (src_entry->visibility.level == Visibility::Level::kPublic &&
              dst_entry->visibility.level == Visibility::Level::kPublic && dst_entry->id &&
