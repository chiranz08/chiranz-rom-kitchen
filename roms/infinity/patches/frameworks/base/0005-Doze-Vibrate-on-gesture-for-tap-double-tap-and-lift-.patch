+    /** "Vibrate on gesture" for tap, double-tap and lift (from Pixelify-AOSP). */
+    private boolean shouldVibrate(@DozeLog.Reason int reason) {
+        if (mVibratorHelper == null || !mVibratorHelper.hasVibrator()) {
+            return false;
+        }
+        final int user = mUserTracker.getUserId();
+        switch (reason) {
+            case DozeLog.REASON_SENSOR_PICKUP:
+                return mConfig.pickupGestureVibrate(user);
+            case DozeLog.REASON_SENSOR_DOUBLE_TAP:
+                return mConfig.doubleTapGestureVibrate(user);
+            case DozeLog.REASON_SENSOR_TAP:
+                return mConfig.tapGestureVibrate(user);
+            default:
+                return false;
+        }
+    }
+
+    private void wakeVibrate() {
+        VibrationEffect effect = VibrationEffect.createWaveform(new long[] { 0, 100 }, -1);
+        if (mVibrator != null && mVibrator.areAllEffectsSupported(VibrationEffect.EFFECT_CLICK)
+                == Vibrator.VIBRATION_EFFECT_SUPPORT_YES) {
+            effect = VibrationEffect.createPredefined(VibrationEffect.EFFECT_CLICK);
+        }
+        final VibrationAttributes attrs = new VibrationAttributes.Builder()
+                .setUsage(VibrationAttributes.USAGE_HARDWARE_FEEDBACK)
+                .setFlags(VibrationAttributes.FLAG_BYPASS_INTERRUPTION_POLICY
+                        | VibrationAttributes.FLAG_BYPASS_USER_VIBRATION_INTENSITY_OFF)
+                .build();
+        mVibratorHelper.vibrate(effect, attrs);
+    }
+
