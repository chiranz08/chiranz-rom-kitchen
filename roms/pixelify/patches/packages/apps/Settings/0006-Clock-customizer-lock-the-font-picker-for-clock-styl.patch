+/**
+ * Whether the lock screen layout of a clock style (SystemUI's, not this app's preview copy) uses
+ * the clock font setting. Styles with their own fixed fonts ignore the picked clock font.
+ */
+private fun styleSupportsClockFont(context: android.content.Context, layoutRes: Int): Boolean {
+    return runCatching {
+        val name = context.resources.getResourceEntryName(layoutRes)
+        val sysui = context.createPackageContext("com.android.systemui", 0).resources
+        val id = sysui.getIdentifier(name, "layout", "com.android.systemui")
+        if (id == 0) return true
+        val clockFont = android.content.res.Resources.getSystem()
+            .getIdentifier("config_clockFontFamily", "string", "android")
+        sysui.getLayout(id).use { parser ->
+            var event = parser.eventType
+            while (event != org.xmlpull.v1.XmlPullParser.END_DOCUMENT) {
+                if (event == org.xmlpull.v1.XmlPullParser.START_TAG) {
+                    for (i in 0 until parser.attributeCount) {
+                        if (parser.getAttributeName(i) == "fontFamily" &&
+                                parser.getAttributeResourceValue(i, 0) == clockFont) {
+                            return true
+                        }
+                    }
+                }
+                event = parser.next()
+            }
+        }
+        false
+    }.getOrDefault(true)
+}
