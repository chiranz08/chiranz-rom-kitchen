+private const val CLOCK_FONT_CATEGORY = "android.theme.customization.lockscreen_clock_font"
+
+private data class ClockFontOption(
+    val packageName: String?,
+    val label: String,
+    val typeface: android.graphics.Typeface?
+)
+
+/** Clock font overlays (lockscreen_clock_font category), "Default" first. */
+private fun loadClockFontOptions(context: android.content.Context): List<ClockFontOption> {
+    val om = context.getSystemService(android.content.om.OverlayManager::class.java)
+        ?: return emptyList()
+    val pm = context.packageManager
+    val fonts = runCatching {
+        om.getOverlayInfosForTarget("android", android.os.UserHandle.SYSTEM)
+            .filter { it.category == CLOCK_FONT_CATEGORY }
+    }.getOrDefault(emptyList()).mapNotNull { info ->
+        runCatching {
+            val ai = pm.getApplicationInfo(info.packageName, 0)
+            val res = pm.getResourcesForApplication(ai)
+            val id = res.getIdentifier("config_clockFontFamily", "string", info.packageName)
+            val typeface = if (id != 0) {
+                android.graphics.Typeface.create(res.getString(id), android.graphics.Typeface.NORMAL)
+            } else null
+            ClockFontOption(info.packageName, ai.loadLabel(pm).toString(), typeface)
+        }.getOrNull()
+    }.sortedBy { it.label.lowercase() }
+    return listOf(ClockFontOption(null, context.getString(R.string.default_value), null)) + fonts
+}
+
+private fun currentClockFontPackage(context: android.content.Context): String? {
+    val om = context.getSystemService(android.content.om.OverlayManager::class.java) ?: return null
+    return runCatching {
+        om.getOverlayInfosForTarget("android", android.os.UserHandle.SYSTEM)
+            .firstOrNull { it.category == CLOCK_FONT_CATEGORY && it.isEnabled }?.packageName
+    }.getOrNull()
+}
+
+private fun applyClockFont(context: android.content.Context, packageName: String?) {
+    val om = context.getSystemService(android.content.om.OverlayManager::class.java) ?: return
+    runCatching {
+        if (packageName == null) {
+            currentClockFontPackage(context)?.let {
+                om.setEnabled(it, false, android.os.UserHandle.SYSTEM)
+            }
+        } else {
+            om.setEnabledExclusiveInCategory(packageName, android.os.UserHandle.SYSTEM)
+        }
+    }
+}
+
+/** Row of clock fonts, each drawn in its own face; tapping one applies it (restarts SystemUI). */
+@Composable
+private fun ClockFontPicker() {
+    val context = LocalContext.current
+    val options = remember { loadClockFontOptions(context) }
+    if (options.size <= 1) return
+    var current by remember { mutableStateOf(currentClockFontPackage(context)) }
+
+    Spacer(modifier = Modifier.height(16.dp))
+    Text(
+        text = stringResource(R.string.clock_font_title),
+        style = MaterialTheme.typography.titleMedium,
+        color = MaterialTheme.colorScheme.onSurface
+    )
+    Spacer(modifier = Modifier.height(10.dp))
+    LazyRow(
+        horizontalArrangement = Arrangement.spacedBy(10.dp),
+        contentPadding = PaddingValues(horizontal = 2.dp),
+        modifier = Modifier.fillMaxWidth()
+    ) {
+        items(count = options.size) { i ->
+            val option = options[i]
+            val selected = option.packageName == current
+            val shape = RoundedCornerShape(18.dp)
+            Column(
+                modifier = Modifier.width(92.dp),
+                horizontalAlignment = Alignment.CenterHorizontally
+            ) {
+                Box(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .height(64.dp)
+                        .clip(shape)
+                        .border(
+                            width = if (selected) 2.5.dp else 0.dp,
+                            color = if (selected) MaterialTheme.colorScheme.primary else Color.Transparent,
+                            shape = shape
+                        )
+                        .background(Color(0xFF111520))
+                        .clickable {
+                            if (option.packageName != current) {
+                                applyClockFont(context, option.packageName)
+                                current = option.packageName
+                                SystemUtilsNew.restartSystemUI(context)
+                            }
+                        },
+                    contentAlignment = Alignment.Center
+                ) {
+                    Text(
+                        text = "12:45",
+                        color = Color.White,
+                        fontSize = 22.sp,
+                        fontFamily = option.typeface?.let {
+                            androidx.compose.ui.text.font.FontFamily(
+                                androidx.compose.ui.text.font.Typeface(it)
+                            )
+                        } ?: androidx.compose.ui.text.font.FontFamily.Default
+                    )
+                }
+                Spacer(modifier = Modifier.height(4.dp))
+                Text(
+                    text = option.label,
+                    style = MaterialTheme.typography.labelSmall,
+                    color = if (selected) MaterialTheme.colorScheme.primary
+                        else MaterialTheme.colorScheme.onSurfaceVariant,
+                    maxLines = 1,
+                    overflow = androidx.compose.ui.text.style.TextOverflow.Ellipsis
+                )
+            }
+        }
     }
 }
 
