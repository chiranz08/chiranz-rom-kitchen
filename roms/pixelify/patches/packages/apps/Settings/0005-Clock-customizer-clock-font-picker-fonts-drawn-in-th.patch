+private val CLOCK_CATEGORY_LABELS = intArrayOf(
+    R.string.clock_category_ios,
+    R.string.clock_category_oneplus,
+    R.string.clock_category_nothing,
+    R.string.clock_category_bold,
+    R.string.clock_category_cards,
+    R.string.clock_category_other,
+)
+
+/** Groups a clock layout by its resource name (index into CLOCK_CATEGORY_LABELS). */
+private fun clockCategory(name: String): Int {
+    val n = name.removePrefix("keyguard_").removePrefix("clock_")
+    fun has(vararg keys: String) = keys.any { n.startsWith(it) }
+    return when {
+        has("ios") -> 0
+        has("oos", "oppo", "cos") -> 1
+        has("nos") -> 2
+        has("big", "tall", "gobold", "modak", "galada", "skewrom", "delirium", "neu", "badeen",
+            "space_age", "polyline", "label", "taden", "mont", "encode", "block", "num", "accent") -> 3
+        has("anci", "spark", "stylish", "life", "word", "bubble", "analog", "sweet", "samurai",
+            "gateway", "pixel") -> 4
+        else -> 5
+    }
+}
