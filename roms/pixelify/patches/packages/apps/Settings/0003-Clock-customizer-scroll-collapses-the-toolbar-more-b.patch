+/** One gallery tile: the wallpaper with the clock drawn at phone width, then scaled down. */
+@Composable
+private fun ClockStyleTile(
+    index: Int,
+    layoutRes: Int,
+    wallpaper: Bitmap?,
+    isSelected: Boolean,
+    onClick: () -> Unit
+) {
+    val shape = RoundedCornerShape(22.dp)
+    val borderColor by animateColorAsState(
+        targetValue = if (isSelected) MaterialTheme.colorScheme.primary else Color.Transparent,
+        label = "tile_border"
+    )
+    Column(horizontalAlignment = Alignment.CenterHorizontally) {
+        Box(
+            modifier = Modifier
+                .fillMaxWidth()
+                .aspectRatio(0.82f)
+                .clip(shape)
+                .border(width = if (isSelected) 3.dp else 0.dp, color = borderColor, shape = shape)
+                .background(Color(0xFF111520))
+                .clickable(onClick = onClick)
+        ) {
+            if (wallpaper != null) {
+                Image(
+                    bitmap = wallpaper.asImageBitmap(),
+                    contentDescription = null,
+                    contentScale = ContentScale.Crop,
+                    alignment = Alignment.TopCenter,
+                    modifier = Modifier.fillMaxSize()
+                )
+                Box(modifier = Modifier.fillMaxSize().background(Color(0x33000000)))
+            }
+            if (index == 0) {
+                Column(
+                    modifier = Modifier.align(Alignment.Center),
+                    horizontalAlignment = Alignment.CenterHorizontally
+                ) {
+                    Icon(
+                        painter = painterResource(R.drawable.ic_settings_date_time),
+                        contentDescription = null,
+                        tint = Color.White,
+                        modifier = Modifier.size(36.dp)
+                    )
+                }
+            } else {
+                AndroidView(
+                    factory = { ctx ->
+                        FrameLayout(ctx).apply {
+                            clipChildren = false
+                            clipToPadding = false
+                            isClickable = false
+                            isFocusable = false
+                            descendantFocusability = ViewGroup.FOCUS_BLOCK_DESCENDANTS
+                            val pad = (24 * resources.displayMetrics.density).toInt()
+                            setPadding(pad, pad * 2, pad, 0)
+                            LayoutInflater.from(ctx).inflate(layoutRes, this, true)
+                            fun hideWeather(v: View) {
+                                if (v is ViewGroup) for (i in 0 until v.childCount) hideWeather(v.getChildAt(i))
+                                if (v is TextView) {
+                                    val idName = runCatching { v.resources.getResourceEntryName(v.id) }
+                                        .getOrNull() ?: return
+                                    if (idName.contains("weather", ignoreCase = true)) v.visibility = View.GONE
+                                }
+                            }
+                            if (childCount > 0) hideWeather(getChildAt(0))
+                        }
+                    },
+                    // Lay the clock out at a phone's width, then scale the result into the tile.
+                    modifier = Modifier.layout { measurable, constraints ->
+                        val virtualWidth = PHONE_WIDTH.roundToPx()
+                        val scale = constraints.maxWidth.toFloat() / virtualWidth
+                        val virtualHeight = (constraints.maxHeight / scale).toInt()
+                        val placeable = measurable.measure(
+                            androidx.compose.ui.unit.Constraints.fixed(virtualWidth, virtualHeight)
+                        )
+                        layout(constraints.maxWidth, constraints.maxHeight) {
+                            placeable.placeWithLayer(0, 0) {
+                                scaleX = scale
+                                scaleY = scale
+                                transformOrigin =
+                                    androidx.compose.ui.graphics.TransformOrigin(0f, 0f)
+                            }
                         }
                     }
+                )
+            }
+            if (isSelected) {
+                Box(
+                    modifier = Modifier
+                        .align(Alignment.TopEnd)
+                        .padding(8.dp)
+                        .size(24.dp)
+                        .clip(CircleShape)
+                        .background(MaterialTheme.colorScheme.primary),
+                    contentAlignment = Alignment.Center
+                ) {
+                    Icon(
+                        imageVector = Icons.Default.Check,
+                        contentDescription = null,
+                        tint = MaterialTheme.colorScheme.onPrimary,
+                        modifier = Modifier.size(15.dp)
+                    )
                 }
             }
         }
+        Spacer(modifier = Modifier.height(6.dp))
+        Text(
+            text = if (index == 0) stringResource(R.string.default_value)
+                else stringResource(R.string.clock_style_number, index),
+            style = MaterialTheme.typography.labelLarge,
+            color = if (isSelected) MaterialTheme.colorScheme.primary
+                else MaterialTheme.colorScheme.onSurface
+        )
     }
 }
 
+private val PHONE_WIDTH = 411.dp
