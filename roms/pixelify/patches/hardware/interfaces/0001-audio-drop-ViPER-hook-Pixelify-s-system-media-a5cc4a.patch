From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chiranz <chiranz08@users.noreply.github.com>
Date: Sat, 3 Oct 2026 19:33:56 +0000
Subject: [PATCH] audio: drop ViPER hook; Pixelify's system/media (a5cc4a1)
 never defines its UUIDs, so it can't compile

---
 audio/aidl/default/EffectConfig.cpp           |   3 +-
 audio/aidl/default/EffectFactory.cpp          |  26 --
 .../effectFactory-impl/EffectFactory.h        |   1 -
 audio/aidl/default/viper/Android.bp           |  38 ---
 audio/aidl/default/viper/ViperEffect.cpp      | 279 ------------------
 audio/aidl/default/viper/ViperEffect.h        |  81 -----
 6 files changed, 1 insertion(+), 427 deletions(-)
 delete mode 100644 audio/aidl/default/viper/Android.bp
 delete mode 100644 audio/aidl/default/viper/ViperEffect.cpp
 delete mode 100644 audio/aidl/default/viper/ViperEffect.h

diff --git a/audio/aidl/default/EffectConfig.cpp b/audio/aidl/default/EffectConfig.cpp
index 1472dea..0d883ac 100644
--- a/audio/aidl/default/EffectConfig.cpp
+++ b/audio/aidl/default/EffectConfig.cpp
@@ -325,8 +325,7 @@ bool EffectConfig::findUuid(const std::pair<std::string, struct EffectLibraries>
     V("spatializer", Spatializer)                          \
     V("virtualizer", Virtualizer)                          \
     V("visualizer", Visualizer)                            \
-    V("volume", Volume)                                    \
-    V("viper", Viper)
+    V("volume", Volume)
 
 #define GENERATE_MAP_ENTRY_V(s, symbol) {s, &getEffectTypeUuid##symbol},
 
diff --git a/audio/aidl/default/EffectFactory.cpp b/audio/aidl/default/EffectFactory.cpp
index aeff617..e3894f9 100644
--- a/audio/aidl/default/EffectFactory.cpp
+++ b/audio/aidl/default/EffectFactory.cpp
@@ -39,7 +39,6 @@ namespace aidl::android::hardware::audio::effect {
 Factory::Factory(const std::string& file) : mConfig(EffectConfig(file)) {
     LOG(DEBUG) << __func__ << " with config file: " << file;
     loadEffectLibs();
-    loadHardcodedEffects();
 }
 
 Factory::~Factory() {
@@ -298,29 +297,4 @@ void Factory::getDlSyms_l(DlEntry& entry) {
     }
 }
 
-void Factory::loadHardcodedEffects() {
-    static const char* kViperLibPaths[] = {
-        "/vendor/lib64/soundfx/libviperaidl.so",
-        "/vendor/lib/soundfx/libviperaidl.so"
-    };
-
-    for (const char* libPath : kViperLibPaths) {
-        if (access(libPath, R_OK) != 0) {
-            continue;
-        }
-
-        Descriptor::Identity id;
-        id.type = getEffectTypeUuidViper();
-        id.uuid = getEffectImplUuidViper();
-        id.proxy = std::nullopt;
-
-        LOG(INFO) << __func__ << " loading hardcoded ViPER effect from " << libPath;
-        if (openEffectLibrary(id.uuid, libPath)) {
-            mIdentitySet.insert(std::move(id));
-        }
-        return;
-    }
-    LOG(DEBUG) << __func__ << " ViPER library not found, skipping";
-}
-
 }  // namespace aidl::android::hardware::audio::effect
diff --git a/audio/aidl/default/include/effectFactory-impl/EffectFactory.h b/audio/aidl/default/include/effectFactory-impl/EffectFactory.h
index 9127dda..d0b8204 100644
--- a/audio/aidl/default/include/effectFactory-impl/EffectFactory.h
+++ b/audio/aidl/default/include/effectFactory-impl/EffectFactory.h
@@ -118,7 +118,6 @@ class Factory : public BnFactory {
             REQUIRES(mMutex);
 
     void loadEffectLibs();
-    void loadHardcodedEffects();
     /* Get effect_dl_interface_s from library handle */
     void getDlSyms_l(DlEntry& entry) REQUIRES(mMutex);
 };
