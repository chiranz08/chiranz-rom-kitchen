From: chiranz <chiranz08@users.noreply.github.com>
Date: Sat, 3 Oct 2026 19:07:32 +0000
Subject: [PATCH 1/3] version: ASCP props to product (shiba enforces generic
 system partition)

---
 config/version.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/config/version.mk b/config/version.mk
index 1187d19..5f67f52 100644
--- a/config/version.mk
+++ b/config/version.mk
@@ -36,7 +36,7 @@ ASCP_VERSION_SUFFIX := $(ASCP_ANDROID_VERSION).$(ASCP_BASE_VERSION).$(ASCP_DEVIC
 ASCP_PACKAGE_VERSION := ASCP-v$(ASCP_BASE_VERSION)-$(TARGET_PRODUCT)-$(ASCP_BUILD_TYPE)-$(ASCP_BUILD_DATE)
 ASCP_VERSION := ASCP OS v$(ASCP_BASE_VERSION) | Android $(ASCP_ANDROID_VERSION) | $(ASCP_BUILD_TYPE)
 
-PRODUCT_SYSTEM_PROPERTIES += \
+PRODUCT_PRODUCT_PROPERTIES += \
     ro.ascp.build.type=$(ASCP_BUILD_TYPE) \
     ro.ascp.build.version=$(ASCP_VERSION_SUFFIX) \
     ro.ascp.version.base=$(ASCP_BASE_VERSION) \

